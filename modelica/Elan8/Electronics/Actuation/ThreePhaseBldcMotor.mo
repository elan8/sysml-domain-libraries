within Elan8.Electronics.Actuation;
model ThreePhaseBldcMotor "Elan8::Electronics::Actuation::ThreePhaseBldcMotor: star-connected permanent-magnet motor on an averaged three-phase inverter, in phase coordinates"
  parameter Modelica.Units.SI.Resistance phaseResistance "SysML: phaseResistance. Per phase";
  parameter Modelica.Units.SI.Inductance phaseInductance "SysML: phaseInductance. Self minus mutual inductance, per phase";
  parameter Modelica.Units.SI.MagneticFlux permanentMagnetFlux "SysML: permanentMagnetFlux. Rotor magnet flux linked by a phase, peak";
  parameter Real polePairs "SysML: polePairs. Number of pole pairs, a positive whole number";
  parameter Real emfShape(min = 0, max = 1) = 0 "SysML: emfShape. 0 gives sinusoidal back-EMF, 1 trapezoidal back-EMF with 120 degree flat tops" annotation(Evaluate = true);
  parameter Modelica.Units.SI.Inertia rotorInertia "SysML: rotorInertia";
  parameter Modelica.Units.SI.Voltage dcLinkVoltage "SysML: dcLinkVoltage. Supply of the inverter";
  Modelica.Mechanics.Rotational.Interfaces.Flange_b mechanicalOutput "SysML: mechanicalOutput";
  input Real dutyA(unit = "1") "Duty cycle of the half bridge on phase A, 0 to 1";
  input Real dutyB(unit = "1") "Duty cycle of the half bridge on phase B, 0 to 1";
  input Real dutyC(unit = "1") "Duty cycle of the half bridge on phase C, 0 to 1";
  Real currentA(unit = "A", start = 0, fixed = true) "Phase A current";
  Real currentB(unit = "A", start = 0, fixed = true) "Phase B current";
  Real currentC(unit = "A", start = 0, fixed = true) "Phase C current";
  Real rotorAngle(unit = "rad") "Mechanical rotor angle";
  Real rotorSpeed(unit = "rad/s") "Mechanical rotor speed";
  Real electricalAngle(unit = "rad") "Rotor angle times the pole pairs; phase A back-EMF is proportional to its sine";
  Real electricalTorque(unit = "N.m") "Air-gap torque on the rotor";
protected
  constant Real pi = Modelica.Constants.pi;
  Modelica.Mechanics.Rotational.Components.Inertia rotor(J = rotorInertia);
  Modelica.Mechanics.Rotational.Sources.Torque torque;
  Real shapeA "Back-EMF waveform of phase A, within -1 to 1";
  Real shapeB;
  Real shapeC;
  Real voltageA(unit = "V") "Inverter leg voltage relative to the DC-link midpoint";
  Real voltageB(unit = "V");
  Real voltageC(unit = "V");
  Real neutral(unit = "V") "Neutral potential of the isolated star point";
equation
  rotorAngle = rotor.phi;
  rotorSpeed = rotor.w;
  electricalAngle = polePairs * rotorAngle;
  shapeA = if emfShape > 0.5 then max(-1, min(1, 6 / pi * asin(sin(electricalAngle)))) else sin(electricalAngle);
  shapeB = if emfShape > 0.5 then max(-1, min(1, 6 / pi * asin(sin(electricalAngle - 2 * pi / 3)))) else sin(electricalAngle - 2 * pi / 3);
  shapeC = if emfShape > 0.5 then max(-1, min(1, 6 / pi * asin(sin(electricalAngle + 2 * pi / 3)))) else sin(electricalAngle + 2 * pi / 3);
  voltageA = (dutyA - 0.5) * dcLinkVoltage;
  voltageB = (dutyB - 0.5) * dcLinkVoltage;
  voltageC = (dutyC - 0.5) * dcLinkVoltage;
  neutral = (voltageA + voltageB + voltageC - permanentMagnetFlux * polePairs * rotorSpeed * (shapeA + shapeB + shapeC)) / 3;
  phaseInductance * der(currentA) = voltageA - neutral - phaseResistance * currentA - permanentMagnetFlux * polePairs * rotorSpeed * shapeA;
  phaseInductance * der(currentB) = voltageB - neutral - phaseResistance * currentB - permanentMagnetFlux * polePairs * rotorSpeed * shapeB;
  phaseInductance * der(currentC) = voltageC - neutral - phaseResistance * currentC - permanentMagnetFlux * polePairs * rotorSpeed * shapeC;
  electricalTorque = permanentMagnetFlux * polePairs * (shapeA * currentA + shapeB * currentB + shapeC * currentC);
  torque.tau = electricalTorque;
  connect(torque.flange, rotor.flange_a);
  connect(rotor.flange_b, mechanicalOutput);
end ThreePhaseBldcMotor;
