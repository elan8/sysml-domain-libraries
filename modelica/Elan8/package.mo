within ;
package Elan8 "Modelica behaviour for the Elan8 SysML domain libraries"
  extends Modelica.Icons.Package;
  annotation(
    uses(Modelica(version = "4.1.0")),
    Documentation(info = "<html><p>Component physics for part definitions of the Elan8 SysML domain
libraries. A part definition names its class with <code>@Elan8::PhysicalModeling::ModelicaModel</code>.
Classes mirror the SysML packages; a parameter has the name of the SysML attribute it receives, in SI
units, and a pin has the name of the SysML port it stands for. See
<code>modelica/README.md</code>.</p></html>"));
end Elan8;
